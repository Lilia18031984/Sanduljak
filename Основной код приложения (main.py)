    def validate_date(self, date_string):
        """Проверяет корректность даты"""
        pattern = r'^\d{4}-\d{2}-\d{2}$'
        if not re.match(pattern, date_string):
            return False
        try:
            datetime.strptime(date_string, "%Y-%m-%d")
            return True
        except ValueError:
            return False
    
    def add_record(self):
        """Добавляет новую запись о погоде"""
        # Получение данных
        date = self.date_entry.get().strip()
        temp_str = self.temp_entry.get().strip()
        description = self.desc_entry.get().strip()
        precipitation = self.precipitation_var.get()
        
        # Валидация даты
        if not self.validate_date(date):
            messagebox.showwarning("Ошибка", "Неверный формат даты!\nИспользуйте ГГГГ-ММ-ДД (например, 2024-01-15)")
            return
        
        # Валидация температуры
        if not temp_str:
            messagebox.showwarning("Ошибка", "Введите температуру!")
            return
        
        try:
            temperature = float(temp_str)
        except ValueError:
            messagebox.showwarning("Ошибка", f"'{temp_str}' — это не число!\nВведите числовое значение температуры.")
            self.temp_entry.delete(0, tk.END)
            return
        
        # Валидация описания
        if not description:
            messagebox.showwarning("Ошибка", "Введите описание погоды!")
            return
        
        # Добавление записи
        record = {
            "date": date,
            "temperature": temperature,
            "description": description,
            "precipitation": precipitation
        }
        
        self.records.append(record)
        # Сортируем по дате (новые сверху)
        self.records.sort(key=lambda x: x["date"], reverse=True)
        self.save_records()
        self.update_table()
        self.update_statistics()
        
        # Очистка полей
        self.temp_entry.delete(0, tk.END)
        self.desc_entry.delete(0, tk.END)
        self.precipitation_var.set(False)
        
        self.status_label.config(text=f"✅ Запись добавлена: {date}, {temperature}°C", fg="#4ecdc4")
        self.window.after(3000, lambda: self.status_label.config(text="💡 Готов к работе", fg="#888888"))
    
    def delete_record(self):
        """Удаляет выбранную запись"""
        selected = self.weather_tree.selection()
        if not selected:
            messagebox.showwarning("Ошибка", "Выберите запись для удаления!")
            return
        
        item = selected[0]
        values = self.weather_tree.item(item, "values")
        date = values[0]
        temp = values[1]
        
        if messagebox.askyesno("Подтверждение", f"Удалить запись:\n📅 {date} | 🌡️ {temp}°C"):
            # Находим и удаляем запись
            for i, record in enumerate(self.records):
                if record["date"] == date and record["temperature"] == float(temp):
                    self.records.pop(i)
                    break
            
            self.save_records()
            self.update_table()
            self.update_statistics()
            self.apply_filter()  # Переприменяем фильтр
            self.status_label.config(text=f"🗑️ Запись удалена", fg="#ff6b6b")
            self.window.after(3000, lambda: self.status_label.config(text="💡 Готов к работе", fg="#888888"))
    
    def apply_filter(self):
        """Применяет фильтрацию записей"""
        filter_date = self.filter_date.get().strip()
        filter_temp_min = self.filter_temp_min.get().strip()
        filter_temp_max = self.filter_temp_max.get().strip()
        
        filtered = self.records.copy()
        
        # Фильтр по дате
        if filter_date:
            if self.validate_date(filter_date):
                filtered = [r for r in filtered if r["date"] == filter_date]
            else:
                messagebox.showwarning("Ошибка", "Неверный формат даты в фильтре!\nИспользуйте ГГГГ-ММ-ДД")
                return
        
        # Фильтр по температуре
        if filter_temp_min:
            try:
                temp_min = float(filter_temp_min)
                filtered = [r for r in filtered if r["temperature"] >= temp_min]
            except ValueError:
                messagebox.showwarning("Ошибка", "Неверное значение минимальной температуры!")
                return
        
        if filter_temp_max:
            try:
                temp_max = float(filter_temp_max)
                filtered = [r for r in filtered if r["temperature"] <= temp_max]
            except ValueError:
                messagebox.showwarning("Ошибка", "Неверное значение максимальной температуры!")
                return
        
        # Обновление таблицы
        self.update_table(filtered)
        
        # Статус
        self.status_label.config(text=f"🔍 Найдено {len(filtered)} записей", fg="#f39c12")
        self.window.after(3000, lambda: self.status_label.config(text="💡 Готов к работе", fg="#888888"))
    
    def reset_filter(self):
        """Сбрасывает фильтр"""
        self.filter_date.delete(0, tk.END)
        self.filter_temp_min.delete(0, tk.END)
        self.filter_temp_max.delete(0, tk.END)
        
        self.update_table()
        self.status_label.config(text="🔄 Фильтр сброшен", fg="#4ecdc4")
        self.window.after(3000, lambda: self.status_label.config(text="💡 Готов к работе", fg="#888888"))
    
    def update_table(self, records_list=None):
        """Обновляет таблицу записей"""
        # Очищаем таблицу
        for item in self.weather_tree.get_children():
            self.weather_tree.delete(item)
        
        if records_list is None:
            records_list = self.records
        
        # Добавляем записи
        for record in records_list:
            precipitation_text = "✅ Да" if record["precipitation"] else "❌ Нет"
            self.weather_tree.insert("", "end", values=(
                record["date"],
                f"{record['temperature']:.1f}",
                record["description"],
                precipitation_text
            ))
    
    def update_statistics(self):
        """Обновляет статистику"""
        if not self.records:
            self.total_label.config(text="Всего записей: 0")
            self.avg_temp_label.config(text="Средняя температура: 0°C")
            self.max_temp_label.config(text="Максимальная температура: 0°C")
            self.min_temp_label.config(text="Минимальная температура: 0°C")
            return
        
        total = len(self.records)
        temps = [r["temperature"] for r in self.records]
        avg_temp = sum(temps) / len(temps)
        max_temp = max(temps)
        min_temp = min(temps)
        
        self.total_label.config(text=f"Всего записей: {total}")
        self.avg_temp_label.config(text=f"Средняя температура: {avg_temp:.1f}°C")
        self.max_temp_label.config(text=f"Максимальная температура: {max_temp:.1f}°C")
        self.min_temp_label.config(text=f"Минимальная температура: {min_temp:.1f}°C")
    
    def on_closing(self):
        """Обработка закрытия окна"""
        if self.save_records():
            self.window.destroy()
    
    def run(self):
        """Запуск приложения"""
        self.window.mainloop()

