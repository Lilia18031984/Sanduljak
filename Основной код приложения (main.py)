import tkinter as tk
from tkinter import ttk, messagebox
import json
from datetime import datetime
import re

class WeatherDiary:
    """Приложение для ведения дневника погоды"""
    
    def __init__(self):
        # Загрузка записей из файла
        self.records = self.load_records()
        
        # Создание главного окна
        self.window = tk.Tk()
        self.window.title("🌤️ Weather Diary")
        self.window.geometry("1000x650")
        self.window.resizable(False, False)
        self.window.configure(bg="#1a1a2e")
        
        # Центрирование окна
        self.center_window()
        
        # Создание интерфейса
        self.create_widgets()
        
        # Обновление таблицы
        self.update_table()
        
        # Обработка закрытия окна
        self.window.protocol("WM_DELETE_WINDOW", self.on_closing)
    
    def center_window(self):
        """Центрирует окно на экране"""
        self.window.update_idletasks()
        width = 1000
        height = 650
        x = (self.window.winfo_screenwidth() // 2) - (width // 2)
        y = (self.window.winfo_screenheight() // 2) - (height // 2)
        self.window.geometry(f"{width}x{height}+{x}+{y}")
    
    def load_records(self):
        """Загружает записи из JSON-файла"""
        try:
            with open("weather.json", "r", encoding="utf-8") as file:
                records = json.load(file)
                if isinstance(records, list):
                    return records
                return []
        except FileNotFoundError:
            return []
        except json.JSONDecodeError:
            messagebox.showerror("Ошибка", "Файл weather.json повреждён")
            return []
    
    def save_records(self):
        """Сохраняет записи в JSON-файл"""
        try:
            with open("weather.json", "w", encoding="utf-8") as file:
                json.dump(self.records, file, ensure_ascii=False, indent=4)
            return True
        except Exception as e:
            messagebox.showerror("Ошибка", f"Не удалось сохранить: {e}")
            return False
    
